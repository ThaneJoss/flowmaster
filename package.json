{
  "name": "flowmaster",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "start": "wrangler dev",
    "build": "vite build && node scripts/verify-build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:worker": "pnpm build && wrangler deploy --dry-run --outdir .worker-build && node tests/worker-smoke.mjs",
    "deploy": "node scripts/publish.mjs deploy",
    "deploy:preview": "node scripts/publish.mjs preview",
    "deploy:check": "node scripts/publish.mjs check",
    "deploy:doctor": "node scripts/check-deployment.mjs",
    "builds:logs": "node scripts/build-logs.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "vue": "3.5.42",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "6.0.7",
    "typescript": "5.9.3",
    "vite": "8.0.7",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
