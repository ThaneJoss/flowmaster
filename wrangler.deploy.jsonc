{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flowmaster",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [{"type":"ESModule","globs":["**/*.js","**/*.mjs"],"fallthrough":true}],
  "assets": {"directory":"dist/client","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"flowmaster-db","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"drizzle"}],
  "vars": {"ALLOWED_ORIGINS":"","MODEL_ALLOWED_HOSTS":""},
  "observability": {"enabled":true}
}
